# Copy to .env at the repo root (gitignored). The hf/ scripts (laptop path) read it automatically.
# Server path (app/): set -a; . ./.env; set +a

# Laptop / HyperFrames path: Groq-hosted whisper-large-v3 transcription (free key: console.groq.com)
GROQ_API_KEY=
# Optional: pin the HyperFrames CLI version used via npx (default: latest)
# HF_VERSION=0.8.186
# Optional YouTube auth for hf/get-gameplay.mjs (usually not needed on a home connection)
# YT_COOKIES_FILE=.secrets/yt-cookies.txt
# YT_BROWSER=firefox

# Server path only: Gemini key for hinglish-ai transcription, the edit planner and the music picker.
GEMINI_API_KEY=

# Caption server port (pipeline talks to 127.0.0.1:$PORT)
PORT=3016
# Heavy-job concurrency inside the caption server (transcribe/export). 1 is safe.
CAP_CONCURRENCY=1
# ffmpeg/ffprobe binaries if not on PATH
# CAP_FFMPEG=/usr/bin/ffmpeg
# CAP_FFPROBE=/usr/bin/ffprobe

# Optional path overrides (defaults = this repo's layout)
# RNF_HOME=/path/to/RNF-EDITING-pipeline
# RNF_SFX_DIR=$RNF_HOME/assets/sfx-pack
# RNF_ASSETS_DIR=$RNF_HOME/assets/game-assets
# RNF_SECRETS_DIR=$RNF_HOME/.secrets          # yt-cookies.txt, yt-cookies-2.txt ... (Netscape format)
# RNF_GEMINI_ENV=$RNF_HOME/.secrets/gemini.env # used only if GEMINI_API_KEY is unset
# RNF_ARCHIVE_DIR=$RNF_HOME/archive
# YTDLP=yt-dlp

# Delivery: rclone remote:folder. Leave empty to keep final.mp4 local only.
RNF_DRIVE_DEST=
# RCLONE=rclone

# Optional: free SteamGridDB key for extra posters
# STEAMGRIDDB_KEY=
